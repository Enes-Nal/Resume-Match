# Server-side only. These are read by the /api/ai proxy (api/ai.ts on Vercel, vite.config.ts locally)
# and are never bundled into the website's JavaScript.

# OpenRouter key that powers the built-in AI for everyone: https://openrouter.ai/keys
# Tip: set a credit limit on the key in OpenRouter so usage can never exceed what you expect.
OPENROUTER_API_KEY=

# Optional: comma-separated models, tried in order (defaults to free models).
# OPENROUTER_MODELS=qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free,openrouter/free

# Optional: requests per visitor IP per 10 minutes (default 60). One analysis uses 4 requests.
# RATE_LIMIT=60

# Optional: extra origins allowed to call the proxy, e.g. a custom domain (the site's own origin is always allowed).
# ALLOWED_ORIGINS=https://resume.example.com
